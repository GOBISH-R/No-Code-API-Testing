# Copy to .env and fill in. Nothing here is read in development except PORT,
# MONGODB_URI and CLIENT_URL — the rest have safe local fallbacks and become
# mandatory only when NODE_ENV=production (see src/config/validateConfig.js).

# ---- Server ----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# The public address of THIS server. Used to build the Google OAuth redirect URI,
# so it must match what you register in the Google Cloud console.
# Defaults to http://localhost:<PORT> when unset.
SERVER_URL=http://localhost:5000

# Number of reverse proxies / load balancers in front of this server (e.g. 1 on
# Render, Railway or behind nginx). Leave blank when clients connect directly.
# Wrong in either direction matters: unset behind a proxy puts every user in one
# rate-limit bucket; set without a proxy lets clients spoof their address.
TRUST_PROXY=

# ---- Database --------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/visual-api-testing-suite

# ---- CORS ------------------------------------------------------------------
# The frontend origin allowed to call this API and open the WebSocket gateway.
CLIENT_URL=http://localhost:5173

# ---- Secrets ---------------------------------------------------------------
# Generate each of these SEPARATELY. Reusing one value for both means a leak of
# either compromises both sessions and every stored API credential — the server
# refuses to start if they match.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signs session cookies. Anyone holding this can forge a session for any account.
SESSION_SECRET=

# Encrypts the API credentials saved on requests (bearer tokens, OAuth secrets,
# passwords). Must be exactly 64 hex characters.
#
# Treat this like a database backup key: change it and every credential already
# stored becomes unreadable, and the app will say so loudly rather than silently
# sending empty tokens.
ENCRYPTION_KEY=

# ---- Email -----------------------------------------------------------------
# Used for address confirmation and password reset. Without a transport those
# emails go nowhere, so both are required in production.
#
# In development they are printed to the terminal instead — click the link from
# there and the whole flow works with no mail account at all.
MAIL_FROM="ApIForge <noreply@example.com>"
SMTP_URL=smtps://user:password@smtp.example.com:465

# ---- Google sign-in (optional) ---------------------------------------------
# Leave both blank and the Google button simply does not appear; email and
# password still work. Setting only one is a startup error, because the failure
# would otherwise surface to whoever tries to sign in rather than to you.
#
# Create at https://console.cloud.google.com/apis/credentials
#   Application type:           Web application
#   Authorized redirect URI:    <SERVER_URL>/api/accounts/google/callback
#
# The redirect URI must match byte for byte, including http vs https and any
# trailing path — Google rejects anything else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
